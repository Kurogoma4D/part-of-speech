{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "part-of-speech",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "dist",
		"run_worker_first": ["/api/*"]
	},
	"ai": { "binding": "AI" },
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		}
	],
	"vars": {
		"MODEL": "@cf/zai-org/glm-5.3-flash",
		"AI_GATEWAY_ID": "part-of-speech"
	}
}

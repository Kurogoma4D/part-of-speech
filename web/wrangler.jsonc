{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "part-of-speech",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "dist",
		"run_worker_first": ["/api/*"]
	},
	"ai": { "binding": "AI" },
	"vars": { "MODEL": "@cf/zai-org/glm-5.3-flash" }
}
